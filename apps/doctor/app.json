{
  "expo": {
    "name": "MediBook for Doctors",
    "slug": "medibook-doctor",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medibook-doctor",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDF2F4",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medibook.doctor"
    },
    "android": {
      "package": "com.medibook.doctor",
      "adaptiveIcon": {
        "backgroundColor": "#FDF2F4"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF2F4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
